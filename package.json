{
  "name": "monitor-cripto",
  "version": "1.0.0",
  "private": true,
  "description": "Tablero XRP · ADA · ALGO — solo se usa Node para compilar el CSS (Tailwind) y correr las pruebas.",
  "scripts": {
    "build:css": "tailwindcss -i assets/css/tailwind.input.css -o assets/css/app.css --minify",
    "watch:css": "tailwindcss -i assets/css/tailwind.input.css -o assets/css/app.css --watch",
    "test": "node --test tests/ta.test.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
